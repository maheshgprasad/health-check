# Copy to .env and fill in the services you want to check.
# Only the variables for the services you select are required.
# Do not commit .env.

# Redis
REDIS_HOST=redis-host
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# MongoDB
MONGO_URL=mongodb://mongo-user:mongo-password@mongo-host:27017/?authSource=admin

# MySQL
DB_HOST=mysql-host
DB_PORT=3306
DB_USERNAME=mysql_user
DB_PASSWORD=mysql_password
DB_NAME=mysql_db_name

# RabbitMQ
RABBIT_HOST=rabbit-host
RABBIT_PORT=5672
RABBIT_USERNAME=rabbit_user
RABBIT_PASSWORD=rabbit_password
RABBIT_VHOST=/
